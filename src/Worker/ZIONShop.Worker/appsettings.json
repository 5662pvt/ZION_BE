{
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=ZionShop;Username=postgres;Password=CHANGE_ME"
  },
  "EventBus": {
    "Provider": "RabbitMq",
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "User": "guest",
    "Pass": "guest",
    "Exchange": "zionshop.events",
    "QueueName": "zionshop.api"
  },
  "Redis": {
    "Configuration": "localhost:6379"
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "ImageStorage": {
    "PublicBaseUrl": ""
  },
  "Checkout": {
    "ShippingFee": 30000,
    "FreeShippingThreshold": 500000,
    "Currency": "VND"
  },
  "Payments": {
    "Fake": {
      "WebhookSecret": "",
      "CheckoutBaseUrl": "http://localhost:3000"
    }
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "no-reply@zionshop.local",
    "FromName": "ZIONShop"
  },
  "Notifications": {
    "StorefrontBaseUrl": "http://localhost:3000"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} cid={CorrelationId} traceId={TraceId} spanId={SpanId}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Otel": {
    "SamplingRatio": 1.0
  },
  "AllowedHosts": "*"
}
