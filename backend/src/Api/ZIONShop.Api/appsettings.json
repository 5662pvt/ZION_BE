{
  "ConnectionStrings": {
    "DefaultConnection": "Host=127.0.0.1;Port=5432;Database=ZionShop;Username=postgres;Password=CHANGE_ME"
  },
  "Jwt": {
    "Issuer": "ZIONShop",
    "Audience": "ZIONShop.Client",
    "SigningKey": "REPLACE_WITH_32+_CHARACTER_RANDOM_STRING_FROM_ENV",
    "AccessMinutes": 15,
    "RefreshDays": 7
  },
  "EventBus": {
    "Provider": "InMemory",
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "User": "guest",
    "Pass": "guest",
    "Exchange": "zionshop.events",
    "QueueName": "zionshop.api"
  },
  "Redis": {
    "Configuration": "localhost:6379"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:4173", "http://localhost:3000" ]
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "ImageStorage": {
    "PublicBaseUrl": ""
  },
  "Checkout": {
    "ShippingFee": 30000,
    "FreeShippingThreshold": 500000,
    "Currency": "VND"
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "no-reply@zionshop.local",
    "FromName": "ZIONShop"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
